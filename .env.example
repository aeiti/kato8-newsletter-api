# Turso database credentials (https://turso.tech)
#   $ turso db show <name> --url
#   $ turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Random salt for hashing client IPs before storing them.
#   $ openssl rand -hex 32
IP_HASH_SALT=replace-with-random-32-char-hex

# Comma-separated CORS allowlist. Local dev + prod + staging.
ALLOWED_ORIGINS=http://localhost:5173,https://kato8studios.com,https://aeiti.github.io
